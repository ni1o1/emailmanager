# ============== 邮箱配置 ==============

# QQ邮箱
QQ_EMAIL_ADDRESS=your_email@qq.com
QQ_EMAIL_PASSWORD=your_app_password

# PKU邮箱
PKU_EMAIL_ADDRESS=your_email@pku.edu.cn
PKU_EMAIL_PASSWORD=your_password

# SZU邮箱
SZU_EMAIL_ADDRESS=your_email@szu.edu.cn
SZU_EMAIL_PASSWORD=your_password

# ============== Kimi API ==============

KIMI_API_KEY=your_kimi_api_key
# API 地址（可选，默认为 Moonshot）
# KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
# 模型名称（可选）
# KIMI_MODEL=kimi-k2.5
# 超时时间（秒，可选）
# KIMI_TIMEOUT=120

# ============== 飞书通知 ==============

# 是否启用飞书通知（true/false）
FEISHU_ENABLED=false

# 飞书自建应用 App ID / App Secret
# 获取路径：https://open.feishu.cn/app -> 创建企业自建应用 -> 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书群聊 chat_id（格式如 oc_xxxxxx）
# 需要把机器人加入该群；chat_id 可在群设置或通过 API 获取
FEISHU_CHAT_ID=

# 通知级别：all（每次处理都通知）/ important（仅重要邮件）/ summary（摘要）
FEISHU_NOTIFY_LEVEL=summary

# 静默时段（不发送通知）- 格式：HH:MM-HH:MM
FEISHU_QUIET_HOURS=23:00-07:00

# ============== 定时任务配置 ==============

# 检查间隔（秒，可选，默认 600 = 10分钟）
# CHECK_INTERVAL=600

# 每批最多处理邮件数（可选，默认 100）
# MAX_EMAILS_PER_BATCH=100

# 每日简报时间（可选，格式 HH:MM，默认 14:00）
# DAILY_REPORT_TIME=14:00

# ============== 邮件签名 ==============

# 自动回复邮件的签名
# 多行签名使用 \n 分隔
# 例如：Best regards,\n\nYour Name\nYour Title
EMAIL_SIGNATURE=
